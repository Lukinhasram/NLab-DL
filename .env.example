# =============================================================================
# MariaDB OLTP source (host-side CLI defaults)
# =============================================================================
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=root
MARIADB_PASSWORD=senhadoida
MARIADB_DATABASE=nlab_db

# Source data paths (relative to repo root or absolute)
MARIADB_CONTAINER=nlab_mariadb
MARIADB_DUMP_FILE=data/dumps/dump_completo.sql
NLAB_CONTENT_DIR=data/nlab-content
NLAB_GIT_LOG_FILE=data/nlab-content/full_log.txt

# Synthetic scaling target (total pages in MariaDB)
TARGET_PAGES=1000000

# =============================================================================
# Data Lake Stack (Silo S3, Hive Metastore, Trino, Airflow, Superset)
# Nota: se alterar S3_ACCESS_KEY / S3_SECRET_KEY / MARIADB_PASSWORD, reflita
# tambem em platform/hive/metastore-site.xml e platform/trino/catalog/*.properties
# =============================================================================
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=siloadmin
S3_SECRET_KEY=siloadmin123
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

HMS_HOST=127.0.0.1
HMS_PORT=9083
HMS_DB_ROOT_PASSWORD=root123
HMS_DB_PASSWORD=hive123

TRINO_HOST=127.0.0.1
TRINO_PORT=8080

AIRFLOW_PORT=8082
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_SECRET_KEY=nlab-lakehouse-airflow-2026

SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=nlab-lakehouse-secret-2026

# DuckDB runtime limits (calibrated for 16 GB Windows host / 8 GB WSL2)
DUCKDB_MEMORY_LIMIT=1000MB
DUCKDB_THREADS=2
